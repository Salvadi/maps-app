# ==============================================================================
# OPImaPPA - Environment Template (Sprint 1)
# ATTENZIONE: Questo file contiene segreti di produzione. Non committare.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 17)
# ------------------------------------------------------------------------------

# Utente applicativo/owner del database. Mantenere 'opimappa' per consistenza con init scripts.
POSTGRES_USER=opimappa

# Nome del database principale.
POSTGRES_DB=opimappa

# Password superuser PostgreSQL (32 caratteri alfanumerici sicuri).
# Generare con: openssl rand -base64 24 | tr -d '\n' | cut -c1-32
POSTGRES_PASSWORD=<GENERATE_32_CHAR>

# Connection string per l'API (Sprint 2). Costruita dalle variabili sopra.
# Formato: postgres://USER:PASSWORD@postgres:5432/DB
DATABASE_URL=postgres://opimappa:<GENERATE_32_CHAR>@postgres:5432/opimappa

# ------------------------------------------------------------------------------
# OBJECT STORAGE (MinIO)
# ------------------------------------------------------------------------------

# Username root per console MinIO (ingresso Tailscale:9001). Diverso dalla API key.
MINIO_ROOT_USER=opimappa-admin

# Password root MinIO (40 caratteri robusti). Usata per accesso iniziale console.
# Generare con: openssl rand -base64 30 | tr -d '\n' | cut -c1-40
MINIO_ROOT_PASSWORD=<GENERATE_40_CHAR>

# Access Key per applicazione API (Sprint 2). 20 caratteri alfanumerici.
# Generare da MinIO Console -> Access Keys -> Create (o: openssl rand -hex 10)
MINIO_API_ACCESS_KEY=<GENERATE_20_CHAR>

# Secret Key associato alla API Access Key. 40 caratteri.
# Generare da MinIO Console o: openssl rand -base64 30 | tr -d '\n' | cut -c1-40
MINIO_API_SECRET_KEY=<GENERATE_40_CHAR>

# Endpoint interno per API (non esporre su internet). L'API lo usa per firmare URL.
MINIO_ENDPOINT=http://minio:9000

# ------------------------------------------------------------------------------
# AUTHENTICATION (Better Auth - Sprint 2)
# ------------------------------------------------------------------------------

# Secret principale per firmare cookie e JWT. 64 byte esadecimali (128 char hex).
# Generare con: openssl rand -hex 64
BETTER_AUTH_SECRET=<GENERATE_64_CHAR>

# URL base pubblico dell'app (calcolabile, ma esplicito per sicurezza).
BETTER_AUTH_URL=https://opimappa.com

# ------------------------------------------------------------------------------
# NETWORKING (Cloudflare Tunnel)
# ------------------------------------------------------------------------------

# Token di autenticazione del tunnel Cloudflare Zero Trust.
# Recuperare da: Cloudflare Dashboard -> Zero Trust -> Networks -> Tunnels -> 
# Creare tunnel "opimappa-prod" -> Copiare il "Tunnel token" (inizia con eyJ...)
TUNNEL_TOKEN=<paste-from-cloudflare-zero-trust-dashboard>

# ------------------------------------------------------------------------------
# SYSTEM
# ------------------------------------------------------------------------------

# Timezone per container (log cron, timestamp backup).
TZ=Europe/Rome

# ==============================================================================
# REMINDER SICUREZZA
# ==============================================================================
# 1. Salvare i valori generati in Bitwarden (vault sicuro).
# 2. Su server: cp .env.example .env && chmod 600 .env
# 3. Verificare proprietario: chown opimappa:opimappa .env
# 4. Non includere mai questo file nei commit (gitignore: .env)
# ==============================================================================
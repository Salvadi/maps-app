# .env.staging — ambiente STAGING (NON committare la versione reale)
# Sul server va copiato in: /opt/opimappa/.env.staging
# Condiviso da api-staging e minio-staging (entrambi env_file in docker-compose.staging.yml).
#
# REGOLA: usare secret DIVERSI da produzione. Lo staging non deve poter
# firmare sessioni valide in prod né accedere ai bucket prod.

# --- Postgres (stesso container prod, DATABASE dedicato opimappa_staging) ---
# Stesse credenziali utente prod, ma DB diverso → dati isolati.
DATABASE_URL=postgres://opimappa:CAMBIA_PASSWORD@postgres:5432/opimappa_staging

# --- BetterAuth ---
# baseURL/trustedOrigins derivano da questo: DEVE essere l'host staging pubblico.
BETTER_AUTH_URL=https://staging.opimappa.com
# Generare nuovo: openssl rand -base64 48  (DIVERSO da prod)
BETTER_AUTH_SECRET=CAMBIA_SECRET_STAGING

# --- MinIO staging (container minio-staging dedicato) ---
# Credenziali root del server MinIO staging (lette da minio-staging all'avvio)
MINIO_ROOT_USER=CAMBIA_MINIO_USER
MINIO_ROOT_PASSWORD=CAMBIA_MINIO_PASSWORD
# Endpoint interno: il container minio-staging sulla rete docker
MINIO_ENDPOINT=http://minio-staging:9000
# Access key usate dall'API (uguali a root sopra, oppure service account dedicato)
MINIO_API_ACCESS_KEY=CAMBIA_MINIO_USER
MINIO_API_SECRET_KEY=CAMBIA_MINIO_PASSWORD

# --- Email transazionale (Resend - reset password) ---
# Stessa API key di prod va bene, ma EMAIL_FROM deve usare dominio verificato su Resend.
RESEND_API_KEY=CAMBIA_RESEND_API_KEY
EMAIL_FROM=OPImaPPA Staging <s.rusin@opifiresafe.com>

# --- Misc ---
TZ=Europe/Rome
PORT=3000

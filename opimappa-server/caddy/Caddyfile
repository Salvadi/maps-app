{
	# Disabilita HTTPS automatico: TLS termina su Cloudflare edge
	auto_https off
	# Disabilita admin endpoint per sicurezza
	admin off
}

# Listener su :80 (Cloudflared edge -> caddy:80)
# TLS e redirect www→non-www gestiti da Cloudflare edge
:80 {
	# Compressione
	encode gzip zstd

	# Logging
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
			roll_keep_for 30d
		}
	}

	# Headers sicurezza globali
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		# CSP allineata a Vercel: API e SSE restano same-origin via /api/*.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://unpkg.com https://cdnjs.cloudflare.com; worker-src 'self' blob: https://unpkg.com https://cdnjs.cloudflare.com; connect-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'"
		-Server
	}

	# Route 1: SSE long-lived (/api/events/stream)
	handle /api/events/stream {
		reverse_proxy api:3000 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# Route 2: API generica (/api/*)
	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
		}
	}

	# Route 3: File server PWA con SPA fallback
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server

		# Cache asset statici: immutable
		@assets {
			path /static/*
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Cache HTML: no-cache
		@html {
			path /index.html
		}
		header @html Cache-Control "no-cache, must-revalidate"

		# Service Worker: no-cache
		@sw {
			path /service-worker.js
		}
		header @sw Cache-Control "no-cache, must-revalidate"
	}
}
